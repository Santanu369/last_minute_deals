<?xml version="1.0" encoding="utf-8"?>
<!-- Icon for the Android 12+ system splash: 288dp canvas, logo (170dp, mostly white padding) inside the
     central 192dp circle that the system leaves visible. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="288dp" android:height="288dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item android:width="170dp" android:height="170dp" android:gravity="center">
        <bitmap android:gravity="fill" android:src="@drawable/splash" />
    </item>
</layer-list>
